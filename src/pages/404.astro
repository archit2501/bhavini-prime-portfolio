---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';

const home = withBase('/');
---

<BaseLayout
  title="Title not found"
  description="This page isn't part of Bhavini Malhotra's portfolio."
  noindex
>
  <section class="missing gutter">
    <h1>We couldn't find that title</h1>
    <p>It may have moved, or the link may be wrong.</p>
    <a class="home" href={home}>
      Go to the home page
    </a>
  </section>
</BaseLayout>

<style>
  .missing {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-block: calc(var(--nav-h) + var(--space-12)) var(--space-12);
  }

  h1 {
    font-size: var(--fs-32);
    font-weight: 700;
    line-height: var(--lh-tight);
  }

  p {
    color: var(--color-text-muted);
    font-size: var(--fs-18);
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-height: var(--cta-h);
    padding: var(--space-2) 1.3125rem;
    border-radius: var(--radius-8);
    background: var(--color-btn-solid);
    color: var(--color-on-light);
    font-size: var(--cta-fs);
    font-weight: 500;
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-cta);
  }

  .home:hover {
    transform: scale(1.03);
  }
</style>
