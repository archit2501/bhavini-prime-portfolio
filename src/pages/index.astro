---
// Minimal home page for the scaffold. Task 1.1.2 replaces this shell with BaseLayout and tokens.
const title = 'Bhavini Malhotra · Sales & Operations';
const description =
  'Bhavini Malhotra, Sales & Operations Executive at F1Jobs.io in Bangalore: $100K+ revenue from 7+ sales, lead generation and customer operations.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00050D" />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <main id="main">
      <h1>Bhavini Malhotra</h1>
      <p>Sales &amp; Operations Executive at F1Jobs.io, Bangalore.</p>
    </main>
    <footer>
      <p>Not affiliated with Amazon, Prime Video or IMDb.</p>
    </footer>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: 24px 72px;
    background: #00050d;
    color: #fff;
    font-family: Arial, sans-serif;
  }
  footer {
    color: #8197a4;
    font-size: 0.9375rem;
  }
  .skip {
    position: absolute;
    left: 16px;
    top: -48px;
    padding: 8px 12px;
    background: #fff;
    color: #00050d;
  }
  .skip:focus {
    top: 16px;
  }
  :focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
</style>
