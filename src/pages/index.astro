---
import HeroCarousel from '../components/home/HeroCarousel.astro';
import LandscapeCard from '../components/rows/LandscapeCard.astro';
import PreviewCard from '../components/rows/PreviewCard.astro';
import Row from '../components/rows/Row.astro';
import TopTenCard from '../components/rows/TopTenCard.astro';
import GenreTile from '../components/skills/GenreTile.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { artwork } from '../lib/artwork-assets';
import { certificationCard, titleCard } from '../lib/cards';
import { rowTitles, topTen } from '../lib/catalog';
import { loadCatalog } from '../lib/content';
import { SITE } from '../lib/site';
import { seasonProgress, tenureLabel } from '../lib/tenure';
import { withBase } from '../lib/url';

const catalog = await loadCatalog();
// Build time stands in for "now": the Continue watching bar is as current as the last deploy.
const now = new Date();
---

<!-- Row cards load lazily so the hero's key art, the LCP image, gets the bandwidth first. -->
<BaseLayout>
  <h1 class="visually-hidden">{SITE.name}</h1>
  <HeroCarousel titles={rowTitles(catalog, 'hero')} />
  <div class="rows">
    {catalog.rows.map((row) => {
      if (row.kind === 'continue') {
        return (
          <Row id={row.id} title={row.title}>
            {rowTitles(catalog, row.id).map((t) => (
              <li>
                <LandscapeCard
                  {...titleCard(t)}
                  image={artwork(t.slug).card}
                  progress={seasonProgress(t.start, now)}
                  progressLabel={`Season 1, ${tenureLabel(t.start, now)}`}
                />
              </li>
            ))}
          </Row>
        );
      }
      if (row.kind === 'top10') {
        return (
          <Row id={row.id} title={row.title} variant="top10">
            {topTen(catalog).map((item) => (
              <li>
                <TopTenCard item={item} />
              </li>
            ))}
          </Row>
        );
      }
      if (row.kind === 'titles') {
        return (
          <Row id={row.id} title={row.title} seeMore={withBase(`/browse/${row.id}/`)}>
            {rowTitles(catalog, row.id).map((t) => (
              <li>
                <LandscapeCard {...titleCard(t)} image={artwork(t.slug).card} />
              </li>
            ))}
          </Row>
        );
      }
      if (row.kind === 'certifications') {
        return (
          <Row id={row.id} title={row.title}>
            {catalog.certifications.map((c) => (
              <li>
                <LandscapeCard {...certificationCard(c)} image={artwork(c.slug).card} />
              </li>
            ))}
          </Row>
        );
      }
      if (row.kind === 'skills') {
        return (
          <Row id={row.id} title={row.title} seeMore={withBase('/skills/')}>
            {catalog.skills.map((s) => (
              <li>
                <GenreTile href={withBase(`/skills/${s.slug}/`)} name={s.name} glow={s.glow} />
              </li>
            ))}
          </Row>
        );
      }
      // The hero renders above.
      return null;
    })}
  </div>
  <PreviewCard catalog={catalog} />
</BaseLayout>

<style>
  /* The first row heading tucks 10px into the hero's faded bottom edge, as on primevideo.com. */
  .rows {
    position: relative;
    z-index: 1;
    margin-top: -0.625rem;
  }
</style>
