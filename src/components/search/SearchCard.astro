---
import type { SearchEntry } from '../../lib/search';

/** One search result: 16:9 art (or a skill tile), then name and meta. Same as resultCard(). */
interface Props {
  entry: SearchEntry;
}

const { entry } = Astro.props;
---

<li>
  <a class="result" href={entry.href}>
    {entry.image ? (
      <span class="result__art">
        <img src={entry.image} alt="" width="480" height="270" loading="lazy" decoding="async" />
      </span>
    ) : (
      <span
        class="result__art result__art--tile"
        style={entry.tone ? `--tone: ${entry.tone}` : undefined}
        aria-hidden="true"
      >
        {entry.name}
      </span>
    )}
    <span class="result__name">{entry.name}</span>
    <span class="result__meta">{entry.meta}</span>
  </a>
</li>
