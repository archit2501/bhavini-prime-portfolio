---
import Check from '@lucide/astro/icons/check';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Info from '@lucide/astro/icons/info';
import Pause from '@lucide/astro/icons/pause';
import Play from '@lucide/astro/icons/play';
import Plus from '@lucide/astro/icons/plus';
import { Picture } from 'astro:assets';
import type { Title } from '../../lib/catalog-schema';
import type { WithSlug } from '../../lib/catalog';
import { artwork } from '../../lib/artwork-assets';
import { periodChip } from '../../lib/carousel';
import { hasTrailer } from '../../lib/trailers';
import { withBase } from '../../lib/url';
import Wordmark from '../brand/Wordmark.astro';
import TitleLogo from '../title/TitleLogo.astro';

/**
 * Prime Video's hero "super carousel", from the live measurements: full-bleed key art weighted
 * right under Prime's eased scrims; at the left, the Original ident, title lettering, tagline,
 * mint status line, a two-line synopsis, the white two-line CTA with round + and i buttons, and
 * the entitlement line; dots centred below; a period chip at the bottom right.
 */
interface Props {
  titles: WithSlug<Title>[];
}

const { titles } = Astro.props;
const slides = titles.map((t, i) => ({
  ...t,
  index: i,
  art: artwork(t.slug),
  chip: periodChip(t.start, t.end),
  href: withBase(`/title/${t.slug}/`),
  // Every hero title has a trailer today; one without would open its page instead.
  watch: withBase(hasTrailer(t.slug) ? `/watch/${t.slug}/` : `/title/${t.slug}/`),
}));
---

<section
  class="hero"
  aria-roledescription="carousel"
  aria-label="Featured titles"
  data-hero
  data-count={slides.length}
>
  <div class="hero__slides" aria-live="off">
    {slides.map((s) => (
      <div
        class="hero__slide"
        role="group"
        aria-roledescription="slide"
        aria-label={`${s.index + 1} of ${slides.length}: ${s.title}`}
        data-slide={s.index}
        data-active={s.index === 0 ? 'true' : 'false'}
        inert={s.index === 0 ? undefined : true}
      >
        <div class="hero__art">
          <Picture
            src={s.art.key}
            alt=""
            formats={['avif', 'webp']}
            widths={[640, 960, 1280, 1920, 2560]}
            sizes="100vw"
            quality={72}
            loading={s.index === 0 ? 'eager' : 'lazy'}
            fetchpriority={s.index === 0 ? 'high' : 'auto'}
            decoding={s.index === 0 ? 'sync' : 'async'}
            class="hero__img"
          />
        </div>
        <div class="hero__scrim" />
        <div class="hero__content gutter">
          <Wordmark variant="ident" height="1.25rem" class="hero__ident" />
          <h2 class="hero__title">
            <a href={s.href} class="hero__title-link">
              <TitleLogo slug={s.slug} label={s.title} width="min(23.4rem, 62vw)" />
            </a>
          </h2>
          <p class="hero__tagline">{s.tagline}</p>
          <p class="hero__status">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="hero__trend">
              <circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="2" />
              <path
                d="M6.5 15l4-4.5 3 3 4.5-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            {s.status}
          </p>
          <p class="hero__synopsis">{s.synopsis}</p>
          <div class="hero__actions">
            <a class="hero__cta" href={s.watch}>
              <Play size={26} fill="currentColor" aria-hidden="true" />
              <span class="hero__cta-text">
                {s.kind === 'series' && <span>Episode 1</span>}
                <span>Watch now</span>
              </span>
            </a>
            <button
              class="round-btn"
              type="button"
              aria-pressed="false"
              aria-label={`Add ${s.title} to My List`}
              data-my-list={s.slug}
              data-my-list-title={s.title}
            >
              <Plus size={30} class="my-list__add" aria-hidden="true" />
              <Check size={30} class="my-list__added" aria-hidden="true" />
            </button>
            <a class="round-btn" href={s.href} aria-label={`More details for ${s.title}`}>
              <Info size={28} aria-hidden="true" />
            </a>
          </div>
          <p class="hero__entitle">
            <svg viewBox="0 0 16 16" aria-hidden="true" class="hero__check">
              <circle cx="8" cy="8" r="8" fill="#0070f0" />
              <path
                d="M4.5 8.2l2.3 2.3 4.7-4.7"
                fill="none"
                stroke="#fff"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            Open to roles
          </p>
        </div>
        <span class="hero__chip">{s.chip}</span>
      </div>
    ))}
  </div>

  <button
    class="hero__edge hero__edge--prev"
    type="button"
    aria-label="Previous title"
    data-hero-prev
  >
    <ChevronLeft size={40} aria-hidden="true" />
  </button>
  <button class="hero__edge hero__edge--next" type="button" aria-label="Next title" data-hero-next>
    <ChevronRight size={40} aria-hidden="true" />
  </button>

  <div class="hero__controls">
    <button class="hero__pause" type="button" aria-label="Pause the carousel" data-hero-pause>
      <Pause size={16} aria-hidden="true" class="hero__pause-icon" />
      <Play size={16} aria-hidden="true" class="hero__play-icon" />
    </button>
    <div class="hero__dots" role="group" aria-label="Choose a title">
      {slides.map((s) => (
        <button
          class="hero__dot"
          type="button"
          aria-label={`Show ${s.title}`}
          aria-current={s.index === 0 ? 'true' : undefined}
          data-dot={s.index}
        />
      ))}
    </div>
  </div>
</section>

<script>
  import { dotScale, shouldAdvance, wrapIndex } from '../../lib/carousel';

  const INTERVAL_MS = 8000;

  for (const hero of document.querySelectorAll<HTMLElement>('[data-hero]')) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const pause = hero.querySelector<HTMLButtonElement>('[data-hero-pause]');
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const state = {
      paused: false,
      engaged: false,
      reducedMotion: motion.matches,
      hidden: document.hidden,
    };
    let active = 0;
    let timer = 0;

    const show = (next: number) => {
      active = wrapIndex(next, slides.length);
      slides.forEach((slide, i) => {
        const on = i === active;
        slide.dataset.active = String(on);
        slide.inert = !on;
        if (on) slide.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
      });
      dots.forEach((dot, i) => {
        if (i === active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
        dot.style.setProperty('--dot-scale', String(dotScale(i, active, dots.length)));
      });
      // Warm the next slide's art so the cross-fade never shows a blank frame.
      slides[wrapIndex(active + 1, slides.length)]
        .querySelectorAll('img')
        .forEach((img) => (img.loading = 'eager'));
    };

    const schedule = () => {
      clearTimeout(timer);
      hero.dataset.playing = String(shouldAdvance(state));
      if (shouldAdvance(state))
        timer = window.setTimeout(() => (show(active + 1), schedule()), INTERVAL_MS);
    };

    const go = (next: number) => {
      show(next);
      schedule();
    };

    hero.querySelector('[data-hero-prev]')?.addEventListener('click', () => go(active - 1));
    hero.querySelector('[data-hero-next]')?.addEventListener('click', () => go(active + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    pause?.addEventListener('click', () => {
      state.paused = !state.paused;
      pause.setAttribute('aria-label', state.paused ? 'Play the carousel' : 'Pause the carousel');
      hero.dataset.paused = String(state.paused);
      schedule();
    });

    const engage = (on: boolean) => () => {
      state.engaged = on;
      schedule();
    };
    hero.addEventListener('pointerenter', engage(true));
    hero.addEventListener('pointerleave', engage(false));
    hero.addEventListener('focusin', engage(true));
    hero.addEventListener('focusout', (e) => {
      if (!hero.contains(e.relatedTarget as Node | null)) engage(false)();
    });
    motion.addEventListener('change', () => {
      state.reducedMotion = motion.matches;
      schedule();
    });
    document.addEventListener('visibilitychange', () => {
      state.hidden = document.hidden;
      schedule();
    });

    hero.dataset.enhanced = 'true';
    show(0);
    schedule();
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    /* Prime sizes the hero at 37/88 of the screen width; phones get a taller crop. */
    height: max(26rem, calc(100vw * 37 / 88));
    max-height: 92vh;
    overflow: hidden;
    background: var(--color-bg);
  }

  .hero__slides,
  .hero__slide {
    position: absolute;
    inset: 0;
  }

  .hero__slide {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-fade) var(--ease-standard),
      visibility 0s linear var(--dur-fade);
  }

  .hero__slide[data-active='true'] {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dur-fade) var(--ease-standard);
  }

  .hero__art {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__art :global(picture),
  .hero__art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__art :global(img) {
    object-fit: cover;
    object-position: 70% 40%;
    transform-origin: 70% 40%;
  }

  /* Ambient motion instead of a trailer: a slow push-in on the active slide's key art. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__slide[data-active='true'] .hero__art :global(img) {
      animation: hero-push 20s var(--ease-standard) both;
    }
  }

  @keyframes hero-push {
    from {
      transform: scale(1);
    }

    to {
      transform: scale(1.06);
    }
  }

  /* Prime's eased scrims (rgba(0,5,13,a) steps from its CSS), from the left and from the bottom. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(0 5 13 / 99.1%) 0%,
        rgb(0 5 13 / 96.4%) 8%,
        rgb(0 5 13 / 91.8%) 15%,
        rgb(0 5 13 / 85.3%) 21%,
        rgb(0 5 13 / 76.8%) 27%,
        rgb(0 5 13 / 66.8%) 33%,
        rgb(0 5 13 / 55.7%) 38%,
        rgb(0 5 13 / 44.3%) 43%,
        rgb(0 5 13 / 33.2%) 48%,
        rgb(0 5 13 / 0%) 62%
      ),
      linear-gradient(
        0deg,
        rgb(0 5 13 / 99.1%) 0%,
        rgb(0 5 13 / 85.3%) 7%,
        rgb(0 5 13 / 55.7%) 14%,
        rgb(0 5 13 / 0%) 30%
      );
  }

  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-3);
    padding-top: calc(var(--nav-h) + var(--space-6));
    /* Puts the CTA at y=430 and the entitlement at y=506 in a 605px hero, as measured. */
    padding-bottom: 4.75rem;
    max-width: calc(36rem + var(--gutter));
  }

  .hero__title {
    margin-block: var(--space-1);
  }

  .hero__title-link {
    display: block;
    border-radius: var(--radius-8);
  }

  .hero__title-link :global(.title-logo) {
    max-height: 11.5rem;
  }

  .hero__tagline {
    font-size: var(--fs-14);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero__status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-mint);
    font-size: var(--fs-16);
    font-weight: 700;
  }

  .hero__trend {
    width: 1.5rem;
    height: 1.5rem;
  }

  .hero__synopsis {
    display: -webkit-box;
    max-width: 32rem;
    overflow: hidden;
    color: var(--color-text);
    font-size: var(--fs-18);
    line-height: 1.45;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  /* 24px from the CTA to the first round button, 8px between round buttons. */
  .hero__cta {
    margin-right: var(--space-4);
  }

  /* Prime's primary CTA: white, 62px, radius 8, two-line label with a play icon. */
  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--cta-h);
    padding: var(--space-2) 1.3125rem;
    border-radius: var(--radius-8);
    background: var(--color-btn-solid);
    color: var(--color-on-light);
    font-size: var(--cta-fs);
    font-weight: 500;
    line-height: 1.15;
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease-cta),
      background-color var(--dur-fast) var(--ease-cta);
  }

  .hero__cta:hover {
    transform: scale(1.04);
  }

  .hero__cta-text {
    display: grid;
  }

  /* Round icon buttons: 61px, 20% white, fully round. */
  .round-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.8125rem;
    height: 3.8125rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-btn);
    color: var(--color-text);
    transition:
      transform var(--dur-base) ease-in-out,
      background-color var(--dur-base) ease-in-out;
  }

  .round-btn:hover {
    background: var(--color-btn-hover);
    transform: scale(1.06);
  }

  .hero__entitle {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-16);
  }

  .hero__check {
    width: 1rem;
    height: 1rem;
  }

  .hero__chip {
    position: absolute;
    right: var(--gutter);
    bottom: 4.75rem;
    padding: 3px 7px;
    border-radius: var(--radius-chip);
    background: var(--color-chip);
    font-size: var(--fs-13);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero__edge {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 6rem;
    border: 0;
    border-radius: var(--radius-8);
    background: transparent;
    color: var(--color-text);
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity var(--dur-fast) ease-in-out;
  }

  .hero__edge--prev {
    left: var(--space-2);
  }

  .hero__edge--next {
    right: var(--space-2);
  }

  .hero[data-enhanced='true'] .hero__edge {
    display: inline-flex;
  }

  .hero:hover .hero__edge,
  .hero__edge:focus-visible {
    opacity: 1;
  }

  .hero__controls {
    position: absolute;
    left: 50%;
    bottom: 3.5rem;
    z-index: 2;
    display: none;
    align-items: center;
    gap: var(--space-3);
    transform: translateX(-50%);
  }

  .hero[data-enhanced='true'] .hero__controls {
    display: flex;
  }

  .hero__dots {
    display: flex;
    align-items: center;
    gap: 0;
  }

  /* 24px hit area around each 6px dot; the active dot is Prime's wider pill. */
  .hero__dot {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    border: 0;
    background: transparent;
  }

  .hero__dot::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 50%);
    transform: translate(-50%, -50%) scale(var(--dot-scale, 1));
    transition:
      width var(--dur-base) var(--ease-standard),
      background-color var(--dur-base) var(--ease-standard);
  }

  .hero__dot[aria-current='true']::after {
    width: 1.25rem;
    background: var(--color-text);
  }

  .hero__pause {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 15%);
    color: var(--color-text);
  }

  .hero__play-icon,
  .hero[data-paused='true'] .hero__pause-icon {
    display: none;
  }

  .hero[data-paused='true'] .hero__play-icon {
    display: block;
  }

  /* Phones: Prime keeps only the lettering, status and entitlement over the art. */
  @media (max-width: 37.4375em) {
    .hero {
      height: 30rem;
    }

    .hero__synopsis,
    .hero__actions,
    .hero__tagline,
    .hero__chip {
      display: none;
    }

    .hero__content {
      padding-bottom: 4.5rem;
    }

    .hero__controls {
      bottom: 1.5rem;
    }
  }
</style>
