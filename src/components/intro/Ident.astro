---
import Wordmark from '../brand/Wordmark.astro';

/**
 * The intro ident, after Prime's Original sting but all our own: on #00050D the blue swoosh
 * draws on, the dot lands, "bhavini original" resolves out of a blur and a light sweeps across,
 * about 3.2 s with the three-note flourish (src/lib/flourish.ts). CSS keyframes only; once per
 * session, with Skip; never under reduced motion (src/scripts/ident.ts).
 */
---

<dialog class="ident" aria-label="bhavini original" data-ident>
  <div class="ident__stage" aria-hidden="true">
    <Wordmark
      variant="ident"
      height="clamp(2.75rem, 1rem + 7vw, 7.5rem)"
      decorative
      class="ident__mark"
    />
    <span class="ident__sweep"></span>
  </div>
  <button class="ident__skip" type="button" data-ident-skip>
    Skip
  </button>
</dialog>

<style>
  .ident {
    width: 100vw;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .ident::backdrop {
    background: var(--color-bg);
  }

  .ident__stage {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    overflow: hidden;
  }

  /* Everything waits for [data-playing], so a closed ident costs nothing. */
  .ident :global(.mark__text),
  .ident :global(.mark__suffix) {
    opacity: 0;
  }

  .ident :global(path.mark__swoosh) {
    clip-path: inset(0 100% 0 0);
  }

  .ident :global(circle.mark__swoosh) {
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
  }

  .ident[data-playing] .ident__stage {
    animation: ident-out 0.4s ease-in 2.8s forwards;
  }

  /* 0.3-1.1 s: the swoosh draws on, left to right. */
  .ident[data-playing] :global(path.mark__swoosh) {
    animation: ident-draw 0.8s cubic-bezier(0.65, 0, 0.35, 1) 0.3s forwards;
  }

  /* 1.0-1.3 s: the dot lands with a little overshoot. */
  .ident[data-playing] :global(circle.mark__swoosh) {
    animation: ident-dot 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) 1s forwards;
  }

  /* 0.6-1.5 s: the words resolve out of a blur. */
  .ident[data-playing] :global(.mark__text),
  .ident[data-playing] :global(.mark__suffix) {
    animation: ident-resolve 0.9s var(--ease-standard) 0.6s forwards;
  }

  .ident__sweep {
    position: absolute;
    inset: -20% auto -20% 0;
    width: 22%;
    background: linear-gradient(
      100deg,
      transparent 0%,
      rgb(255 255 255 / 0%) 30%,
      rgb(255 255 255 / 28%) 50%,
      rgb(255 255 255 / 0%) 70%,
      transparent 100%
    );
    mix-blend-mode: screen;
    opacity: 0;
    transform: translateX(-120%) skewX(-12deg);
    pointer-events: none;
  }

  /* 1.6-2.4 s: a light sweeps across the lockup. */
  .ident[data-playing] .ident__sweep {
    animation: ident-sweep 0.8s var(--ease-standard) 1.6s forwards;
  }

  .ident__skip {
    position: absolute;
    right: var(--gutter);
    bottom: max(var(--space-8), env(safe-area-inset-bottom));
    min-height: 2.75rem;
    padding: 0 var(--space-6);
    border: 2px solid rgb(255 255 255 / 60%);
    border-radius: var(--radius-8);
    background: rgb(0 5 13 / 60%);
    color: var(--color-text);
    font-weight: 700;
  }

  .ident__skip:hover {
    background: var(--color-btn-solid);
    color: var(--color-on-light);
  }

  @keyframes ident-draw {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes ident-dot {
    to {
      transform: scale(1);
    }
  }

  @keyframes ident-resolve {
    from {
      opacity: 0;
      filter: blur(0.5rem);
    }

    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @keyframes ident-sweep {
    0% {
      opacity: 0;
      transform: translateX(-120%) skewX(-12deg);
    }

    20% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateX(560%) skewX(-12deg);
    }
  }

  @keyframes ident-out {
    to {
      opacity: 0;
      transform: scale(1.02);
    }
  }
</style>
