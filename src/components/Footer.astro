---
import { RESUME_PATH } from '../lib/contact';
import { SITE } from '../lib/site';
import { withBase } from '../lib/url';
import Wordmark from './brand/Wordmark.astro';
import ContactLink from './ContactLink.astro';

const year = 2026;
---

<footer class="footer gutter">
  <Wordmark tone="muted" height="1.75rem" decorative />
  <ul class="links">
    <li>
      <a href={SITE.linkedin} rel="me noopener" target="_blank">
        LinkedIn
      </a>
    </li>
    <li>
      <a href={SITE.organization.url} rel="noopener" target="_blank">
        F1Jobs.io
      </a>
    </li>
    <li>
      <ContactLink kind="email" label="Email" />
    </li>
    <li>
      <a href={withBase(RESUME_PATH)} download>
        Resume (PDF)
      </a>
    </li>
    <li>
      <a href="#top">Back to top</a>
    </li>
    <li class="copyright">
      © {year} {SITE.name}
    </li>
  </ul>
  <p class="disclaimer">{SITE.disclaimer}</p>
</footer>

<style>
  /* Prime's footer: centred wordmark, one line of blue links, copyright in the grey-blue. */
  .footer {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding-block: var(--space-12) var(--space-8);
    color: var(--color-footer-text);
    font-size: var(--fs-15);
    text-align: center;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a,
  .links :global(a.contact) {
    display: inline-block;
    min-height: 24px;
    color: var(--color-footer-link);
    text-decoration: none;
  }

  .links a:hover,
  .links :global(a.contact:hover) {
    text-decoration: underline;
  }
</style>
