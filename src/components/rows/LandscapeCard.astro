---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Wordmark from '../brand/Wordmark.astro';

/**
 * Prime Video's 16:9 row card: art with the title lettering baked in, radius 8, a white
 * uppercase ribbon top right and the provider mark bottom right (here the "bhavini" wordmark,
 * in the place of Prime's channel logos). Fixed aspect ratio, so rows never shift (CLS 0).
 */
interface Props {
  href: string;
  /** The title's name; the art carries it visually, this carries it for screen readers. */
  title: string;
  image: ImageMetadata;
  ribbon?: string;
  /** Extra text for screen readers after the title, e.g. "Series, May 2026 to now". */
  description?: string;
  /** Slug the hover card (task 2.2.4) and My List (task 3.3.5) key off. */
  slug?: string;
  eager?: boolean;
}

const { href, title, image, ribbon, description, slug, eager = false } = Astro.props;
---

<a class="card" href={href} data-card={slug}>
  <Picture
    src={image}
    alt=""
    formats={['avif', 'webp']}
    widths={[320, 480, 640, 960, 1280]}
    sizes="(min-width: 112.5em) 300px, (min-width: 87.5em) 260px, (min-width: 55em) 24vw, (min-width: 37.5em) 44vw, 60vw"
    quality={74}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class="card__img"
  />
  {ribbon && (
    <span class="card__ribbon" aria-hidden="true">
      {ribbon}
    </span>
  )}
  <Wordmark class="card__mark" height="0.875rem" decorative />
  <span class="visually-hidden">
    {title}
    {description && `, ${description}`}
    {ribbon && `, ${ribbon.toLowerCase()}`}
  </span>
</a>

<style>
  .card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-8);
    background: var(--color-chip);
    color: var(--color-text);
  }

  .card :global(picture),
  .card :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card :global(img) {
    object-fit: cover;
  }

  .card__ribbon {
    position: absolute;
    top: 0;
    right: 0;
    padding: 3px 5px;
    border-radius: 0 0 0 var(--radius-chip);
    background: var(--color-btn-solid);
    color: var(--color-on-light);
    font-size: var(--fs-11);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .card :global(.card__mark) {
    position: absolute;
    right: 0.625rem;
    bottom: 0.625rem;
    opacity: 0.9;
  }
</style>
